<?xml version="1.0" encoding="utf-8"?>
<!--
  SO-101 (SO-ARM101) follower arm — arm-only 5-DOF kinematics + collision meshes.

  Provenance: derived from TheRobotStudio/SO-ARM100
    Simulation/SO101/so101_new_calib.urdf
    @ commit fda892cba81032c46c40976a48c9ceadbf40a9ca
    License: Apache-2.0 (see SO-ARM100-LICENSE alongside this file).

  Modifications from upstream:
    (a) the "gripper" revolute joint and its child link
        "moving_jaw_so101_v1_link" (servo 6) were removed, yielding an
        arm-only 5-DOF model (servos 1-5). The gripper is a separate Viam
        servo-6 component with its own meshes.
    (b) each arm link's collision geometry is ONE merged mesh
        (meshes/<link>_collision.stl, ~88k tris / 4.2 MB total), generated by
        arm/gen_collision_meshes.py: each sub-part is baked into its <collision>
        <origin> and the parts are concatenated into a single mesh in the link
        frame, referenced here with an identity <origin>. This is required
        because rdk's URDF parser keeps only the FIRST <collision> per link
        (referenceframe/model_urdf.go); the upstream multi-part links would
        otherwise contribute a single offset sub-part. Printable parts come from
        the optimized STL/SO101/Individual print files and servo bodies from
        Simulation/SO101/assets (decimated to ~3k tris); the merged mesh itself
        is not decimated, keeping the geometry clean. use_urdf ships these
        pre-optimized meshes (mesh_decimation_ratios empty; rdk's runtime mesh
        decimation hangs on dense meshes). <visual> mirrors <collision>; rdk
        ignores <visual>.
    (c) link and joint frames are renamed to so101.json's names (links base,
        shoulder, upper_arm, lower_arm, wrist; joints 1-5), and the end effector
        is "tool" at so101.json's TCP (see the End effector comment below). This
        makes use_urdf a true drop-in for so101.json: identical frame names,
        kinematics, and TCP; only the collision geometry differs (per-link
        meshes vs so101.json's primitives). Baking these into the file (rather
        than editing the parsed model in memory) is REQUIRED because a component
        ships its kinematics to viam-server as ModelConfig().OriginalFile.Bytes,
        i.e. this raw URDF; in-memory edits would be lost across the module
        gRPC boundary (see makeSO101ModelURDF and TestURDFModelSurvivesSerialization).
        The mesh files keep their upstream-derived names (base_link_collision.stl,
        etc.) even though the links are renamed; only the geometry provenance is
        encoded in the filename.

  Units: meters (URDF convention); the SVA kinematics in so101.json are in mm.
-->
<!-- Generated using onshape-to-robot -->
<!-- Onshape https://cad.onshape.com/documents/7715cc284bb430fe6dab4ffd/w/4fd0791b683777b02f8d975a/e/826c553ede3b7592eb9ca800 -->
<robot name="so101_new_calib">

  <!-- Materials -->
  <material name="3d_printed">
    <color rgba="1.0 0.82 0.12 1.0"/>
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- Link base -->
  <link name="base">
    <inertial>
      <origin xyz="0.0137179 -5.19711e-05 0.0334843" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link_collision.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link shoulder -->
  <link name="shoulder">
    <inertial>
      <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/>
      <mass value="0.100006"/>
      <inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05" iyz="1.54663e-07" izz="2.39783e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/shoulder_link_collision.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/shoulder_link_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link upper_arm -->
  <link name="upper_arm">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/upper_arm_link_collision.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/upper_arm_link_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link lower_arm -->
  <link name="lower_arm">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lower_arm_link_collision.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/lower_arm_link_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Link wrist -->
  <link name="wrist">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="3.6412e-06" izz="2.1e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wrist_link_collision.stl"/>
      </geometry>
      <material name="3d_printed"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/wrist_link_collision.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- End effector: "tool" is so101.json's TCP frame, i.e. joint-5 (wrist roll) output with a
       180deg flip (matching so101.json's "tool" link, euler 0 pi 0.0486795). Baked in here so the
       raw URDF that ships to viam-server (ModelConfig().OriginalFile.Bytes) already has the correct
       end effector; an intermediate "tool_mount" carries joint 5's rotation and the fixed
       "tool_joint" applies the flip (a revolute joint's child cannot carry an extra rotation). -->
  <link name="tool_mount"/>
  <joint name="tool_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 3.14159 0.0486795"/>
    <parent link="tool_mount"/>
    <child link="tool"/>
  </joint>
  <link name="tool"/>

  <!-- Joint from wrist to gripper -->
  <joint name="5" type="revolute">
    <origin xyz="5.55112e-17 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="wrist"/>
    <child link="tool_mount"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.74385" upper="2.84121"/>
  </joint>

  <transmission name="wrist_roll_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="5">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor5">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from lower_arm to wrist -->
  <joint name="4" type="revolute">
    <origin xyz="-0.1349 0.0052 3.62355e-17" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm"/>
    <child link="wrist"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.65806" upper="1.65806"/>
  </joint>

  <transmission name="wrist_flex_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor4">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from upper_arm to lower_arm -->
  <!-- Note: 5-degree calibration offset applied to joint limits -->
  <joint name="3" type="revolute">
    <origin xyz="-0.11257 -0.028 1.73763e-16" rpy="-3.63608e-16 8.74301e-16 1.5708"/>
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.69" upper="1.69"/>
  </joint>

  <transmission name="elbow_flex_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor3">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from shoulder to upper_arm -->
  <joint name="2" type="revolute">
    <origin xyz="-0.0303992 -0.0182778 -0.0542" rpy="-1.5708 -1.5708 0"/>
    <parent link="shoulder"/>
    <child link="upper_arm"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.74533" upper="1.74533"/>
  </joint>

  <transmission name="shoulder_lift_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor2">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

  <!-- Joint from base to shoulder -->
  <joint name="1" type="revolute">
    <origin xyz="0.0388353 -8.97657e-09 0.0624" rpy="3.14159 4.18253e-17 -3.14159"/>
    <parent link="base"/>
    <child link="shoulder"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-1.91986" upper="1.91986"/>
  </joint>

  <transmission name="shoulder_pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
    </joint>
    <actuator name="motor1">
      <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>

</robot>
